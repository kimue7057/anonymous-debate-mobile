SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key

# This static GitHub Pages app cannot read .env directly.
# Provide the same values at runtime without hardcoding secrets in app.js:
#
# window.SUPABASE_CONFIG = {
#   url: "https://your-project-ref.supabase.co",
#   anonKey: "your-public-anon-key"
# };
#
# For local testing only, you can also set these in the browser console:
# localStorage.setItem("SUPABASE_URL", "https://your-project-ref.supabase.co");
# localStorage.setItem("SUPABASE_ANON_KEY", "your-public-anon-key");

# Admin page
# /admin/ uses the same public anon key. Never use a service_role key in the browser.
# You can either save the values in the admin settings form, or edit admin/admin.js:
#
# const ADMIN_SUPABASE_URL = "https://your-project-ref.supabase.co";
# const ADMIN_SUPABASE_ANON_KEY = "your-public-anon-key";
